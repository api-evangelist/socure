{
  "info": {
    "_postman_id": "634527ee-3876-48c2-9f47-2415d65e6bb8",
    "name": "Socure ID+ API",
    "description": "The Socure ID+ API is the unified REST surface for the ID+ platform. A single\n`POST /api/3.0/EmailAuthScore` (legacy name retained for compatibility) accepts a\n`modules` array describing which modules to evaluate \u2014 KYC (Socure Verify), eCBSV,\nSigma Identity Fraud, Sigma Synthetic Fraud, Sigma First-Party Fraud, Email\nRiskScore, Phone RiskScore, Address RiskScore, Digital Intelligence, Graph\nIntelligence, Global Watchlist Screening, Deceased Check, Account Intelligence,\nPrefill, and the Decision rules engine \u2014 and returns a single combined response\nwith `referenceId`, module result blocks, and an optional `decision` block.\n\n\nContact Support:\n Name: Socure Developer Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-06-05T15:17:49.000Z",
    "updatedAt": "2026-06-05T15:17:50.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-634527ee-3876-48c2-9f47-2415d65e6bb8"
  },
