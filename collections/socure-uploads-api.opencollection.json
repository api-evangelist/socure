{
  "opencollection": "1.0.0",
  "info": {
    "name": "Socure Account Intelligence Uploads API",
    "version": "3.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Uploads",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Upload A DocV Document",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.socure.com/api/3.0/devices/:deviceId/documents",
            "params": [
              {
                "name": "deviceId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "type",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "image",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Upload a document image (front, back, or selfie) for a DocV transaction."
        }
      ]
    }
  ],
  "bundled": true
}