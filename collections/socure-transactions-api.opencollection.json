{
  "opencollection": "1.0.0",
  "info": {
    "name": "Socure Account Intelligence Transactions API",
    "version": "3.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Transactions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create A DocV Transaction",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.socure.com/api/3.0/EmailAuthScore",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a DocV transaction by passing `docvTransaction` in the modules array."
        },
        {
          "info": {
            "name": "Verify A DocV Document",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.socure.com/api/3.0/documents/verify",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Finalize a DocV transaction and trigger document/selfie verification."
        },
        {
          "info": {
            "name": "Get A DocV Transaction",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.socure.com/api/3.0/documents/:docvTransactionId",
            "params": [
              {
                "name": "docvTransactionId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve the current state and result of a DocV transaction."
        }
      ]
    }
  ],
  "bundled": true
}