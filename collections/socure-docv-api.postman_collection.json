  "info": {
    "_postman_id": "09f5bb3e-4dc7-43b9-8ab4-172cc2a62373",
    "name": "Socure Predictive DocV API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Predictive Document Verification (DocV) verifies government-issued ID documents\nand matches them to a live selfie with liveness detection. The DocV REST API\ncreates session-orchestrated transactions, manages document/selfie uploads, and\nretrieves verification outcomes. Session lifecycle events are also pushed via\nwebhooks — see the companion DocV AsyncAPI document.\n\n\nContact Support:\n Name: Socure Developer Support",
      "type": "text/plain"
    }
  }
