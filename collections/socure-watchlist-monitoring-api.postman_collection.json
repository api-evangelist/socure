  "info": {
    "_postman_id": "fde4a4a6-de90-4eec-898b-d3110e661fee",
    "name": "Socure Global Watchlist Monitoring API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Continuous monitoring of customer identities against global sanctions lists\n(OFAC, UN, EU, HMT, DFAT), PEP lists, and adverse media sources. Submit profiles\nfor monitoring, retrieve match alerts, manage match dispositions, and receive\nwebhook callbacks when a customer matches a newly added or updated list entry.\n",
      "type": "text/plain"
    }
  }
